# Autonomous Deployment System Configuration
# Copy this file to .env and update with your actual values

# ===========================================
# CORE APPLICATION SETTINGS
# ===========================================
NODE_ENV=development
PORT=5000

# ===========================================
# ORCHESTRATOR SETTINGS
# ===========================================
ORCHESTRATOR_PORT=4001
AGENT_ORCHESTRATOR_PORT=4000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
MONGODB_URI=mongodb://localhost:27017/casperdev
REDIS_URL=redis://localhost:6379

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# SLACK INTEGRATION (REQUIRED FOR AUTONOMOUS ONBOARDING)
# ===========================================
# Get your Slack bot token from: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-real-slack-bot-token-here
SLACK_WORKSPACE_ID=your-slack-workspace-id

# Target user for autonomous onboarding (from Slack thread context)
TARGET_USER_ID=U098G3Y2YDT

# ===========================================
# HUBSPOT INTEGRATION
# ===========================================
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_PORTAL_ID=your-hubspot-portal-id

# ===========================================
# GITHUB INTEGRATION (BFai Team)
# ===========================================
GITHUB_TOKEN=your-github-personal-access-token
GITHUB_ORG=BillionForgeAispace
GITHUB_REPO=demo-repository

# ===========================================
# LINEAR INTEGRATION (BFai Team)
# ===========================================
LINEAR_API_KEY=your-linear-api-key
LINEAR_TEAM_ID=0bfff9ac-1cf2-41c3-89e1-726996ff50cf
LINEAR_TEAM_KEY=BFA

# ===========================================
# JIRA INTEGRATION (BFai Team)
# ===========================================
JIRA_URL=https://bfaispace.atlassian.net
JIRA_EMAIL=your-jira-email
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=BFAIS

# ===========================================
# UPWORK INTEGRATION (Python Service)
# ===========================================
UPWORK_API_KEY=your-upwork-api-key
UPWORK_API_SECRET=your-upwork-api-secret

# ===========================================
# EMAIL CONFIGURATION (for onboarding notifications)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===========================================
# AUTONOMOUS DEPLOYMENT SETTINGS
# ===========================================
# Compliance and governance thresholds
MIN_SYSTEM_HEALTH_THRESHOLD=75
MIN_COMPLIANCE_SCORE=75
MAX_ONBOARDING_ATTEMPTS=3

# Allowed email domains for user validation
ALLOWED_EMAIL_DOMAINS=billionforge.ai,bfai.com,gmail.com

# ===========================================
# WEBHOOK ENDPOINTS (for integrations)
# ===========================================
WEBHOOK_SECRET=your-webhook-secret-key
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ===========================================
# N8N WORKFLOW AUTOMATION
# ===========================================
N8N_URL=http://localhost:5678
N8N_USERNAME=admin
N8N_PASSWORD=password

# ===========================================
# MONITORING AND LOGGING
# ===========================================
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_HEALTH_MONITORING=true

# ===========================================
# CLIENT CONFIGURATION
# ===========================================
CLIENT_URL=http://localhost:3000
SOCKET_URL=http://localhost:5000

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Set to true to enable simulation mode (for testing without real API calls)
SIMULATION_MODE=true
DEBUG_MODE=false